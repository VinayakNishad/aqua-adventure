NODE_ENV=development
PORT=5000

# MongoDB connection string (required)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?appName=<app>

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://aqua-adventure.vercel.app

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Places (reviews and photos)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Firebase Admin: full service-account JSON on ONE line (required for admin routes)
FIREBASE_SERVICE_ACCOUNT=
# Comma-separated admin emails (alternative to the `admin` custom claim)
ADMIN_EMAILS=
